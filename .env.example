# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (required)
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site (required in production — used for canonical URLs, sitemap and OG tags)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Maps (optional)
# Without a key the property map falls back to an OpenStreetMap embed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Logo artwork (optional — only to override the shipped brand)
#
# Prime Real Estate's own artwork lives in public/ and is used when these are
# blank: logo.png, logo-white.png, logo-mark.png, logo-mark-white.png. Set them
# only to run the site under different branding.
#
# The `-white` files are the ink knocked out to white for dark surfaces (the
# footer, the hero overlay, the admin sidebar). Crop every export tight to the
# artwork — a square canvas with wide margins renders as a tiny logo floating
# in empty space — and export with a transparent background.
#
#   NEXT_PUBLIC_LOGO_SRC=/logo.png                    full lockup
#   NEXT_PUBLIC_LOGO_SRC_LIGHT=/logo-white.png        full lockup, dark surfaces
#   NEXT_PUBLIC_LOGO_MARK_SRC=/logo-mark.png          mark only, no wordmark
#   NEXT_PUBLIC_LOGO_MARK_SRC_LIGHT=/logo-mark-white.png
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LOGO_SRC=
NEXT_PUBLIC_LOGO_SRC_LIGHT=
NEXT_PUBLIC_LOGO_MARK_SRC=
NEXT_PUBLIC_LOGO_MARK_SRC_LIGHT=

# ---------------------------------------------------------------------------
# Hero photograph (optional)
# Any full-width property photo. Add its hostname to next.config.ts if it is
# not Unsplash or Supabase Storage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HERO_IMAGE=

# ---------------------------------------------------------------------------
# Inquiry notifications (optional — both channels are independent)
# ---------------------------------------------------------------------------
# Email via Resend
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=

# Any JSON endpoint: WhatsApp Business relay, Slack incoming webhook, n8n, …
INQUIRY_WEBHOOK_URL=
