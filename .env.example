# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (required)
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site (required in production — used for canonical URLs, sitemap and OG tags)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Maps (optional)
# Without a key the property map falls back to an OpenStreetMap embed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Logo artwork (recommended)
#
# Save the real files under public/ and point these at them. Whatever is set
# here is rendered as-is, so the logo matches the source artwork exactly.
# Leave blank and a hand-traced SVG approximation is used instead.
#
# Crop the export tight to the artwork — a square canvas with wide margins
# will render as a tiny logo floating in empty space.
#
#   NEXT_PUBLIC_LOGO_SRC=/logo.png              full lockup, light backgrounds
#   NEXT_PUBLIC_LOGO_SRC_LIGHT=/logo-white.png  knocked out, for the dark footer
#   NEXT_PUBLIC_LOGO_MARK_SRC=/logo-mark.png    mark only, no wordmark
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LOGO_SRC=
NEXT_PUBLIC_LOGO_SRC_LIGHT=
NEXT_PUBLIC_LOGO_MARK_SRC=

# ---------------------------------------------------------------------------
# Hero photograph (optional)
# Any full-width property photo. Add its hostname to next.config.ts if it is
# not Unsplash or Supabase Storage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HERO_IMAGE=

# ---------------------------------------------------------------------------
# Inquiry notifications (optional — both channels are independent)
# ---------------------------------------------------------------------------
# Email via Resend
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=

# Any JSON endpoint: WhatsApp Business relay, Slack incoming webhook, n8n, …
INQUIRY_WEBHOOK_URL=
